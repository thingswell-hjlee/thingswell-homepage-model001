{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thingswell.co.kr/schema/slot.schema.json",
  "title": "싱스웰 콘텐츠 슬롯 공통 스키마",
  "description": "v2 콘텐츠 레이어의 슬롯 JSON 공통 계약. validate-content.mjs가 이 계약을 코드로 강제한다(현재는 Node 내장 모듈 기반 경량 수동 검증). status=ready 항목만 빌드 차단 대상.",
  "type": "object",
  "required": ["slotType", "status", "updatedAt", "items"],
  "properties": {
    "slotType": {
      "type": "string",
      "enum": ["patents", "rnd", "certificates", "cases", "products"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "ready"],
      "description": "draft=골격/미확정(위반 시 경고). ready=검증 통과 필수(위반 시 빌드 차단)."
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "sitemap lastmod 자동 반영 근거일."
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/slotItemBase" }
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": ["string", "null"] },
        "en": { "type": ["string", "null"] }
      },
      "description": "ko/en 파리티 필수. status=ready면 둘 다 non-null이어야 한다."
    },
    "slotItemBase": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "_todo": {
          "type": "array",
          "items": { "type": "string" },
          "description": "확인 필요한 필드 목록. JSON은 주석을 못 담으므로 TODO(확인필요)를 이 배열로 표기한다."
        },
        "_evidence": {
          "type": "string",
          "description": "값의 근거(원문/자산 경로). 특허·인증·수치는 이 근거가 있어야 status=ready 승격 가능."
        }
      }
    },
    "patentItem": {
      "allOf": [{ "$ref": "#/definitions/slotItemBase" }],
      "properties": {
        "regNumber": { "type": "string", "description": "특허 번호(등록/출원)." },
        "legalStatus": {
          "type": ["string", "null"],
          "enum": ["출원", "공개", "등록", "거절", "소멸", null],
          "description": "허위표시 방지 핵심 필드. 출원을 등록으로 표기 금지."
        },
        "title": { "$ref": "#/definitions/bilingual" },
        "date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "image": { "type": ["string", "null"], "description": "src/assets/ 상대 파일명. 실제 파일 존재 검증." }
      }
    }
  }
}
