{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thingswell.co.kr/schema/slot.schema.json",
  "title": "싱스웰 콘텐츠 슬롯 공통 스키마",
  "description": "v2 콘텐츠 레이어의 슬롯 JSON 공통 계약. 값의 원본은 docs/DATA-SOURCE.md — 원장에 없는 특허·실적·센서·수치는 슬롯에 넣지 않는다. validate-content.mjs가 이 계약을 코드로 강제한다(Node 내장 모듈 기반). status=ready 슬롯의 위반은 빌드 차단.",
  "type": "object",
  "required": ["slotType", "status", "updatedAt", "items"],
  "properties": {
    "slotType": {
      "type": "string",
      "enum": ["patents", "rnd", "certificates", "cases", "products"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "ready"],
      "description": "draft=골격/미확정(위반 시 경고). ready=검증 통과 필수(위반 시 빌드 차단)."
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "sitemap lastmod 자동 반영 근거일."
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/slotItemBase" }
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": ["string", "null"] },
        "en": { "type": ["string", "null"] }
      },
      "description": "ko/en 쌍. en 미확정 시 null 허용 — 화면은 ko로 폴백하되 슬롯 _todo에 확인 항목을 남긴다."
    },
    "slotItemBase": {
      "type": "object",
      "required": ["id", "_evidence"],
      "properties": {
        "id": { "type": "string" },
        "_todo": {
          "type": "array",
          "items": { "type": "string" },
          "description": "확인 필요한 필드 목록. JSON은 주석을 못 담으므로 TODO(확인필요)를 이 배열로 표기한다. ready 슬롯에서는 비어 있어야 한다."
        },
        "_evidence": {
          "type": "string",
          "description": "값의 근거 — 원칙적으로 docs/DATA-SOURCE.md의 섹션/행 참조."
        }
      }
    },
    "patentItem": {
      "allOf": [{ "$ref": "#/definitions/slotItemBase" }],
      "properties": {
        "appNumber": { "type": "string", "description": "출원번호" },
        "regNumber": { "type": "string", "description": "등록번호 (registered만)" },
        "pubNumber": { "type": "string", "description": "공개번호 (pending 등)" },
        "isFlagship": { "type": "boolean" },
        "legalStatus": {
          "type": ["string", "null"],
          "enum": ["registered", "pending", "rejected", null],
          "description": "docs/DATA-SOURCE.md §1 기준. registered만 '등록특허' 표기 가능. pending은 '출원 중' 병기 필수. rejected는 로더가 필터하며 어떤 화면에도 노출 금지."
        },
        "title": { "$ref": "#/definitions/bilingual" },
        "image": { "type": ["string", "null"], "description": "src/assets/ 상대 파일명. 실제 파일 존재 검증." }
      }
    },
    "rndItem": {
      "allOf": [{ "$ref": "#/definitions/slotItemBase" }],
      "properties": {
        "ntisId": { "type": "string" },
        "title": { "$ref": "#/definitions/bilingual" },
        "ministry": { "$ref": "#/definitions/bilingual" },
        "period": { "type": "string", "pattern": "^\\d{4}-\\d{2} ~ \\d{4}-\\d{2}$" },
        "role": { "type": "string", "enum": ["주관", "참여연구개발기관"], "description": "DATA-SOURCE 표기 그대로. '참여'를 '주관'으로 격상 금지." },
        "axis": { "type": "string", "enum": ["industrial", "care", "environment", "platform"] },
        "customerFacing": { "type": "boolean", "description": "false면 고객용 페이지 제외(회사소개·IR 전용)." }
      }
    }
  }
}
